# Secrets and local environment
.env
.env.*

# Dependencies
node_modules/

# Rendered welcome email — carries the live CLAIM_SECRET in its claim links.
# This repository is public and GitHub Pages serves its root, so a committed
# copy would be readable at folaadeleke.com. Generated by worker/configure.mjs;
# the tracked welcome-email.html keeps the placeholder instead.
welcome-email.rendered.html

# Back office — buyer certificates, invoices, agreements, contact lists.
# This repository is public and GitHub Pages serves its root, so anything
# committed here is readable at folaadeleke.com/back-office/<path>. A
# Disallow rule in robots.txt does not restrict access, it only asks
# crawlers not to index. Keep this directory local.
back-office/

# macOS
.DS_Store

# Trade programme sources — room renders, build scripts, lookbook masters.
# Only the published trade/<token>/ page is tracked.
trade/lookbook-src/
