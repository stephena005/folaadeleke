#!/bin/sh
# Runs before every commit:
#   1. scripts/update-sitemap.mjs — sets each sitemap <lastmod> from git
#      (today for pages in this commit) and re-stages sitemap.xml so the
#      date moves in the same commit as the page.
#   2. scripts/check-site.mjs — the site guardrails, against what is
#      about to be committed.
#
# This repo is public and GitHub Pages serves main's root with no CI gate,
# so a bad commit is live a minute after it is pushed. This hook is the
# only check that runs BEFORE that. Enable it once per clone:
#
#   git config core.hooksPath .githooks
#
# (npm install does this too, via the "prepare" script in package.json.)
# Skip for one commit with:  git commit --no-verify

root="$(git rev-parse --show-toplevel)"
node "$root/scripts/update-sitemap.mjs" && git add -- "$root/sitemap.xml" || exit 1
exec node "$root/scripts/check-site.mjs"
