{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- assign p = all_products[section.settings.product] -%}
{%- assign hero = section.settings.image | default: p.featured_media.preview_image -%}
{%- assign hero_alt = hero.alt | default: p.title -%}

<section class="figure-hero{% if section.settings.dark %} figure-hero--dark{% endif %}">
  <div class="figure-hero-media">
    {%- if hero != blank -%}
      {{ hero | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '800, 1200, 1600, 2400', alt: hero_alt }}
    {%- else -%}
      <div class="figure-hero-placeholder">[ Choose a product or image ]</div>
    {%- endif -%}
  </div>

  <div class="figure-hero-copy">
    {%- if section.settings.kicker != blank -%}
      <p class="figure-hero-kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h1 class="figure-hero-title">{{ section.settings.heading | default: p.title | escape }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="figure-hero-text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if p != blank -%}
      {%- assign colour_option = nil -%}
      {%- for option in p.options_with_values -%}
        {%- capture is_colour -%}{%- render 'colour-option-check', name: option.name -%}{%- endcapture -%}
        {%- if is_colour == 'true' -%}{%- assign colour_option = option -%}{%- endif -%}
      {%- endfor -%}
      {%- if colour_option -%}
        <ul class="card-swatches card-swatches--hero">
          {%- for value in colour_option.values -%}
            {%- capture hex -%}{%- render 'swatch-colour', value: value -%}{%- endcapture -%}
            <li class="card-swatch" title="{{ value | escape }}"{% if hex != blank %} style="background: {{ hex | strip }}"{% endif %}></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <p class="figure-hero-price">{% if p.price_varies %}From {% endif %}{{ p.price_min | money }}</p>
      <a href="{{ p.url }}" class="btn-primary figure-hero-cta">{{ section.settings.cta | default: 'Shop now' }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured figure",
  "tag": "div",
  "class": "section-featured-figure",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Defaults to the product's first image. A wide banner (e.g. the three colourways on black) works best." },
    { "type": "checkbox", "id": "dark", "label": "Black background", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New — Collectible figure" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the product title." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Shop now" }
  ],
  "presets": [{ "name": "Featured figure" }]
}
{% endschema %}
