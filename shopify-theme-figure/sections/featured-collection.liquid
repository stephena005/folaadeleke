{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- assign c = collections[section.settings.collection] | default: collections.all -%}

<section class="collection-page collection-page--embedded">
  {%- if section.settings.heading != blank -%}
    <div class="collection-header">
      <h2 class="collection-title">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}
  {%- if c.products.size > 0 -%}
    <div class="collection-grid">
      {%- for product in c.products limit: section.settings.limit -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="collection-empty"><p>Nothing here yet.</p></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "class": "section-featured-collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 1, "max": 24, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
