{{ 'cart.css' | asset_url | stylesheet_tag }}

<section class="cart-page">
  <div class="cart-header">
    <h1 class="cart-title">Your Cart</h1>
  </div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form" novalidate>

      <div class="cart-items">
        <div class="cart-items-head">
          <span>Item</span>
          <span class="cart-col-price">Price</span>
          <span class="cart-col-qty">Qty</span>
          <span class="cart-col-total">Total</span>
          <span class="cart-col-remove"></span>
        </div>

        {%- for item in cart.items -%}
          <div class="cart-item">
            <div class="cart-item-image">
              <a href="{{ item.url }}">
                {%- if item.image -%}
                  {%- assign item_alt = item.image.alt | default: item.product.title -%}
                  {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item_alt }}
                {%- endif -%}
              </a>
            </div>

            <div class="cart-item-details">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                {%- for option in item.options_with_values -%}
                  <span class="cart-item-spec">{{ option.name }}: {{ option.value }}</span>
                {%- endfor -%}
              {%- endunless -%}
              {%- for property in item.properties -%}
                {%- assign first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and first_char != '_' -%}
                  <span class="cart-item-spec">{{ property.first }}: {{ property.last }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if item.selling_plan_allocation -%}
                <span class="cart-item-spec">{{ item.selling_plan_allocation.selling_plan.name }}</span>
              {%- endif -%}
            </div>

            <div class="cart-col-price cart-item-price">{{ item.original_price | money }}</div>

            <div class="cart-col-qty cart-item-qty-wrap">
              <div class="qty-control">
                <button type="button" class="qty-btn" data-step="-1" data-line="{{ forloop.index }}" aria-label="Decrease quantity">−</button>
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                  class="qty-input"
                  id="qty-{{ forloop.index }}"
                  aria-label="Quantity for {{ item.product.title | escape }}"
                />
                <button type="button" class="qty-btn" data-step="1" data-line="{{ forloop.index }}" aria-label="Increase quantity">+</button>
              </div>
            </div>

            <div class="cart-col-total cart-item-line-price">{{ item.final_line_price | money }}</div>

            <div class="cart-col-remove">
              <a href="{{ item.url_to_remove }}" class="cart-remove-btn" aria-label="Remove {{ item.product.title | escape }}">×</a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-summary">
        <div class="cart-summary-inner">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-summary-row">
              <span>Discount ({{ discount.title }})</span>
              <span>−{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}

          <div class="cart-summary-row cart-summary-subtotal">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <p class="cart-summary-note">{{ section.settings.note }}</p>

          <button type="submit" name="checkout" class="btn-primary">Checkout</button>
          <button type="submit" name="update" class="btn-secondary cart-update" hidden>Update</button>
          <a href="{{ routes.all_products_collection_url }}" class="btn-secondary cart-continue">Continue Shopping</a>
        </div>
      </div>

    </form>
  {%- else -%}
    <div class="cart-empty">
      <p class="cart-empty-message">Your cart is empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-primary cart-empty-cta">Shop</a>
    </div>
  {%- endif -%}
</section>

<script>
(function() {
  var form = document.getElementById('cart-form');
  if (!form) return;
  var update = form.querySelector('.cart-update');
  var timer;

  // Quantity changes post the form (name="update") so totals stay correct.
  function scheduleUpdate() {
    clearTimeout(timer);
    timer = setTimeout(function() { form.requestSubmit(update); }, 500);
  }

  form.querySelectorAll('.qty-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var input = document.getElementById('qty-' + btn.dataset.line);
      var max = parseInt(input.max, 10) || Infinity;
      var val = (parseInt(input.value, 10) || 0) + parseInt(btn.dataset.step, 10);
      input.value = Math.min(max, Math.max(0, val));
      scheduleUpdate();
    });
  });
  form.querySelectorAll('.qty-input').forEach(function(input) {
    input.addEventListener('change', scheduleUpdate);
  });
})();
</script>

{% schema %}
{
  "name": "Cart",
  "tag": "div",
  "class": "section-cart",
  "settings": [
    { "type": "text", "id": "note", "label": "Summary note", "default": "Shipping calculated at checkout. Figures ship boxed and tracked." }
  ]
}
{% endschema %}
