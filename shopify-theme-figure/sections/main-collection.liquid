{{ 'collection.css' | asset_url | stylesheet_tag }}

<section class="collection-page">
  <div class="collection-header">
    <h1 class="collection-title">
      {%- if collection.handle == 'all' -%}{{ section.settings.all_title }}{%- else -%}{{ collection.title }}{%- endif -%}
    </h1>
    {%- if collection.description != blank -%}
      <div class="collection-description">{{ collection.description }}</div>
    {%- elsif section.settings.fallback_description != blank -%}
      <p class="collection-description">{{ section.settings.fallback_description }}</p>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    <div class="collection-meta">
      <span>{{ collection.products_count }} {{ collection.products_count | pluralize: 'piece', 'pieces' }}</span>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="collection-grid">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- else -%}
      <div class="collection-empty"><p>Nothing here yet.</p></div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "tag": "div",
  "class": "section-collection",
  "settings": [
    { "type": "text", "id": "all_title", "label": "Title for the All collection", "default": "Objects" },
    { "type": "text", "id": "fallback_description", "label": "Description when the collection has none", "default": "Collectible figures by Fola Adeleke" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 3, "max": 48, "step": 3, "default": 24 }
  ]
}
{% endschema %}
